# Enable Firestore publishing from the Python pipeline
FIRESTORE_ENABLED=true

# Absolute path to Firebase service-account JSON key
FIREBASE_CREDENTIALS=/home/toru2/keys/firebase-service-account.json

# Firestore target
FIRESTORE_COLLECTION=zone_counts
FIRESTORE_ALERT_COLLECTION=zone_alerts
FIRESTORE_DOCUMENT_ID=live
FIRESTORE_CAMERA_ID=camera_1

# Publish behavior
FIRESTORE_MIN_PUBLISH_INTERVAL_S=0.2
FIRESTORE_ONLY_ON_CHANGE=true
